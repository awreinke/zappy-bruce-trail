<gpx version="1.1" creator="Claude Bruce Trail planner" xmlns="http://www.topografix.com/GPX/1/1">
<metadata><name>Day 83 - Burnt Point Loop, Dolostone Arch, Burnt Point Access Trail, Shortcut</name></metadata>
<wpt lat="45.249700" lon="-81.645066"><name>P Start/finish parking</name><desc>There is an official municipal parking lot at the end of Dunks Bay Road at the water…</desc><sym>Parking Area</sym></wpt>
<wpt lat="45.250997" lon="-81.633869"><name>J1</name><desc>J1: Junction. Turn right to stay on the main Bruce Trail, heading east. (the blue-blazed Dolostone Arch Side Trail goes off ahead.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="45.251495" lon="-81.630001"><name>J2</name><desc>J2: Turn left onto the blue-blazed Dolostone Arch Side Trail, heading north. (the white-blazed main Bruce Trail goes off on your right.) The next 1.3 km follows an unopened road allowance (rough track, no traffic).</desc><sym>Waypoint</sym></wpt>
<wpt lat="45.248837" lon="-81.646589"><name>J3</name><desc>J3: You pass the start again. Keep going on the white-blazed main Bruce Trail, heading north-west.</desc><sym>Waypoint</sym></wpt>
<wpt lat="45.257446" lon="-81.649133"><name>J4</name><desc>J4: Turn right onto the blue-blazed Burnt Point Access Trail, heading north-east. (the white-blazed main Bruce Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="45.258204" lon="-81.647332"><name>J5</name><desc>J5: Junction. Continue straight to stay on the Burnt Point Access Trail, heading north-east. (the blue-blazed view point-LDB goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="45.258629" lon="-81.646878"><name>J6</name><desc>J6: Turn sharp left onto the blue-blazed Burnt Point Loop Side Trail, heading west. (the blue-blazed Burnt Point Loop Side Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="45.261914" lon="-81.643856"><name>J7</name><desc>J7: Turn right onto the blue-blazed Shortcut, heading south-east. (the blue-blazed Burnt Point Loop Side Trail goes off ahead.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="45.261211" lon="-81.642357"><name>J8</name><desc>J8: Turn left onto the blue-blazed Burnt Point Loop Side Trail, heading north-east. (the blue-blazed Burnt Point Loop Side Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
