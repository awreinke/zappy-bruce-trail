<gpx version="1.1" creator="Claude Bruce Trail planner" xmlns="http://www.topografix.com/GPX/1/1">
<metadata><name>Day 39 - Walter Tovell, South Outlier Loop Trail, Carriage, Lookout, South Outlier Connector</name></metadata>
<wpt lat="44.064042" lon="-80.081273"><name>P Start/finish parking</name><desc>Limited roadside parking on south side of 25 Sideroad where the Walter Tovell Side Trail…</desc><sym>Parking Area</sym></wpt>
<wpt lat="44.055353" lon="-80.078061"><name>J1</name><desc>J1: Junction. Turn left to stay on the Walter Tovell Side Trail, heading east. (the blue-blazed Lookout Side Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.045134" lon="-80.072428"><name>J2</name><desc>J2: Turn left onto the blue-blazed Carriage Side Trail, heading north-east. (the blue-blazed Walter Tovell Side Trail goes off ahead.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.046460" lon="-80.069374"><name>J3</name><desc>J3: Junction. Continue straight to stay on the Carriage Side Trail, heading north-east. (the blue-blazed South Outlier Connector goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.046985" lon="-80.062063"><name>J4</name><desc>J4: End of the Carriage Side Trail. There is trailhead parking here (Mono Cliffs' Ontario Parks Parking Lot: 3rd Line EHS, 900 metres north of Dufferin Rd 8). Turn around and retrace your steps.</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.044806" lon="-80.068663"><name>J5</name><desc>J5: Turn right onto the blue-blazed South Outlier Loop Trail, heading south. (the blue-blazed South Outlier Loop Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.030784" lon="-80.068122"><name>J6</name><desc>J6: Junction. Continue straight to stay on the South Outlier Loop Trail, heading south. (the blue-blazed South Outlier Loop Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.029306" lon="-80.069106"><name>J7</name><desc>J7: Turn right onto the blue-blazed Walter Tovell Side Trail, heading north. (the white-blazed main Bruce Trail goes off ahead; the white-blazed main Bruce Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.044455" lon="-80.072001"><name>J8</name><desc>J8: Junction. Continue straight to stay on the Walter Tovell Side Trail, heading north. (the blue-blazed Carriage Side Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.043399" lon="-80.073828"><name>J9</name><desc>J9: Continue straight onto the white-blazed main Bruce Trail, heading south-west. (the white-blazed main Bruce Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.045071" lon="-80.076885"><name>J10</name><desc>J10: Junction. Continue straight to stay on the main Bruce Trail, heading north. (the blue-blazed McCarston's Lake Side Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.053093" lon="-80.085811"><name>J11</name><desc>J11: Turn right onto the blue-blazed Lookout Side Trail, heading west. (the white-blazed main Bruce Trail goes off ahead.)</desc><sym>Waypoint</sym></wpt>
