<gpx version="1.1" creator="Claude Bruce Trail planner" xmlns="http://www.topografix.com/GPX/1/1">
<metadata><name>Day 37 - Whitetail Refuge, Hockley Heights</name></metadata>
<wpt lat="44.026195" lon="-80.071516"><name>P Start/finish parking</name><desc>Mono Community Centre, 200 m south of Mono Centre (County Road 8). Free</desc><sym>Parking Area</sym></wpt>
<wpt lat="44.027014" lon="-80.068530"><name>J1</name><desc>J1: Turn left onto the white-blazed main Bruce Trail, heading north. (the white-blazed main Bruce Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.029306" lon="-80.069106"><name>J2</name><desc>J2: Turn right onto the blue-blazed South Outlier Loop Trail, heading east. (the white-blazed main Bruce Trail goes off on your left; the blue-blazed Walter Tovell Side Trail goes off ahead.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.030784" lon="-80.068122"><name>J3</name><desc>J3: Junction. Turn right to stay on the South Outlier Loop Trail, heading east. (the blue-blazed South Outlier Loop Trail goes off ahead.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.031395" lon="-80.064768"><name>J4</name><desc>J4: Continue straight onto the blue-blazed Whitetail Refuge Side Trail, heading north-east. (the blue-blazed South Outlier Loop Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.022863" lon="-80.060747"><name>J5</name><desc>J5: Turn left onto the white-blazed main Bruce Trail, heading south-west. (the white-blazed main Bruce Trail goes off ahead.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.021788" lon="-80.061350"><name>J6</name><desc>J6: Junction. Turn left to stay on the main Bruce Trail, heading south-east. (the blue-blazed Springwater Side Trail goes off ahead.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.014463" lon="-80.053082"><name>J7</name><desc>J7: Turn left onto the blue-blazed Hockley Heights Side Trail, heading east. (the white-blazed main Bruce Trail goes off ahead.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.013536" lon="-80.052036"><name>J8</name><desc>J8: Turnaround point. Turn around and retrace your steps.</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.022479" lon="-80.063286"><name>J9</name><desc>J9: Turn left onto the white-blazed main Bruce Trail, heading north. (the white-blazed main Bruce Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.023185" lon="-80.063761"><name>J10</name><desc>J10: Junction. Continue straight to stay on the main Bruce Trail, heading north. (the blue-blazed Turnbull Side Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.025963" lon="-80.065414"><name>J11</name><desc>J11: Junction. Turn left to stay on the main Bruce Trail, heading north-west. (the blue-blazed Turnbull Side Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
