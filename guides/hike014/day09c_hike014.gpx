<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="Claude Bruce Trail planner" xmlns="http://www.topografix.com/GPX/1/1">
<metadata><name>Day 9 (stop 3 of 3) - Mountainview, Beamsville Bench, Angel</name></metadata>
<wpt lat="43.157888" lon="-79.497415"><name>P Start/finish parking</name><desc>Mountainview Conservation Area: Enter from Mountainview Rd. Free</desc><sym>Parking Area</sym></wpt>
<wpt lat="43.164320" lon="-79.499190"><name>P2 alternative parking</name><desc>Angels Gate Winery has generously provided four parking spaces for Bruce Trail hikers. Free. Joins the route near km 1.2 (180 m walk).</desc><sym>Parking Area</sym></wpt>
<wpt lat="43.157570" lon="-79.497879"><name>J1</name><desc>J1: Junction. Turn sharp right to stay on the main Bruce Trail, heading north. (the blue-blazed Mountainview Side Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.161022" lon="-79.499504"><name>J2</name><desc>J2: Junction. Continue straight to stay on the main Bruce Trail, heading west. (the blue-blazed Beamsville Bench Side Trail goes off ahead.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.161030" lon="-79.500168"><name>J3</name><desc>J3: Turnaround point. Turn around and retrace your steps.</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.162747" lon="-79.500569"><name>J4</name><desc>J4: Continue straight onto the blue-blazed Angel Side Trail, heading north-west. (the blue-blazed Beamsville Bench Side Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.164109" lon="-79.500745"><name>J5</name><desc>J5: End of the Angel Side Trail. Turn around and retrace your steps.</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.162389" lon="-79.501427"><name>J6</name><desc>J6: Continue straight onto the white-blazed main Bruce Trail, heading south-west. (the white-blazed main Bruce Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.161146" lon="-79.502785"><name>J7</name><desc>J7: Turn left onto the blue-blazed Mountainview Side Trail, heading east. (the white-blazed main Bruce Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
