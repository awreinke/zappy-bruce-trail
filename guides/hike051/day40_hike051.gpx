<gpx version="1.1" creator="Claude Bruce Trail planner" xmlns="http://www.topografix.com/GPX/1/1">
<metadata><name>Day 40 - Primrose Loop, Boyne Valley Rim, Meadows, Murphy's Pinnacle, Centre Road, Prince of Wales</name></metadata>
<wpt lat="44.117420" lon="-80.128361"><name>P Start/finish parking</name><desc>Off-Road parking area on Centre Rd, south of the 5 Sideroad, at the edge of the forest. Free</desc><sym>Parking Area</sym></wpt>
<wpt lat="44.105940" lon="-80.139530"><name>P2 alternative parking</name><desc>Roadside parking where the Primrose Loop Side Trail crosses County Rd 19 (Prince of Wales Rd). Free. Joins the route near km 2.3 (0 m walk).</desc><sym>Parking Area</sym></wpt>
<wpt lat="44.100050" lon="-80.137340"><name>P3 alternative parking</name><desc>A parking lot on County Rd 19 (Prince of Wales Rd) 80 metres south of the southern end of the…. Free. Joins the route near km 3.3 (260 m walk).</desc><sym>Parking Area</sym></wpt>
<wpt lat="44.119200" lon="-80.112590"><name>P4 alternative parking</name><desc>Roadside parking on 1st Line E. Free. Joins the route near km 9.9 (700 m walk).</desc><sym>Parking Area</sym></wpt>
<wpt lat="44.109810" lon="-80.110870"><name>P5 alternative parking</name><desc>Roadside parking on 1st Line East. Free. Joins the route near km 9.9 (1310 m walk).</desc><sym>Parking Area</sym></wpt>
<wpt lat="44.115942" lon="-80.128070"><name>J1</name><desc>J1: Turn right onto the blue-blazed Murphy's Pinnacle Side Trail, heading west. (the blue-blazed Centre Road Side Trail goes off ahead; the blue-blazed Meadows Side Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.113626" lon="-80.133628"><name>J2</name><desc>J2: Junction. Continue straight to stay on the Murphy's Pinnacle Side Trail, heading south. (the blue-blazed Boyne Valley Rim Side Trail goes off ahead.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.113156" lon="-80.133460"><name>J3</name><desc>J3: End of the Murphy's Pinnacle Side Trail. Turn around and retrace your steps.</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.112636" lon="-80.131318"><name>J4</name><desc>J4: Turn right onto the blue-blazed Primrose Loop Side Trail, heading west. (the blue-blazed Boyne Valley Rim Side Trail goes off ahead.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.106157" lon="-80.142446"><name>J5</name><desc>J5: Junction. Turn left to stay on the Primrose Loop Side Trail, heading south. (the blue-blazed Primrose Loop Side Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.104993" lon="-80.142113"><name>J6</name><desc>J6: Junction. Continue straight to stay on the Primrose Loop Side Trail, heading south. (the blue-blazed Primrose Loop Side Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.103710" lon="-80.140345"><name>J7</name><desc>J7: Continue straight onto the blue-blazed Prince of Wales Side Trail, heading south-east.</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.101735" lon="-80.137550"><name>J8</name><desc>J8: End of the Prince of Wales Side Trail. Turn around and retrace your steps.</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.112768" lon="-80.127342"><name>J9</name><desc>J9: Continue straight onto the blue-blazed Centre Road Side Trail, heading north. (the blue-blazed Boyne Valley Rim Side Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.115622" lon="-80.116878"><name>J10</name><desc>J10: Junction. Continue straight to stay on the Meadows Side Trail, heading east. (the blue-blazed Boyne Valley Rim Side Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.115575" lon="-80.114254"><name>J11</name><desc>J11: Turnaround point. The side trail meets the white-blazed main Bruce Trail here. Turn around and retrace your steps.</desc><sym>Waypoint</sym></wpt>
