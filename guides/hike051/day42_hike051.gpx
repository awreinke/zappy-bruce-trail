<metadata><name>Day 42 - Pine River Valley, Carl Alexander, Melodonna, Kilgorie, Bell Lookout</name></metadata>
<wpt lat="44.172483" lon="-80.157538"><name>P Start/finish parking</name><desc>Roadside parking on 15 Sideroad at Prince of Wales Rd</desc><sym>Parking Area</sym></wpt>
<wpt lat="44.171402" lon="-80.161653"><name>J1</name><desc>J1: Turn right onto the blue-blazed Pine River Valley Side Trail, heading west. (the white-blazed main Bruce Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.169773" lon="-80.164265"><name>J2</name><desc>J2: Continue straight onto the blue-blazed Carl Alexander Side Trail, heading south. (the blue-blazed Pine River Valley Side Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.164487" lon="-80.168968"><name>J3</name><desc>J3: Continue straight onto the blue-blazed Pine River Valley Side Trail, heading north-east. (the blue-blazed Pine River Valley Side Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.166927" lon="-80.159227"><name>J4</name><desc>J4: Continue straight onto the white-blazed main Bruce Trail, heading north-east. (the white-blazed main Bruce Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.167463" lon="-80.158669"><name>J5</name><desc>J5: Turn right onto the blue-blazed Bell Lookout Side Trail, heading north-east. (the white-blazed main Bruce Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.167702" lon="-80.158003"><name>J6</name><desc>J6: End of the Bell Lookout Side Trail. Turn around and retrace your steps.</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.173832" lon="-80.149384"><name>J7</name><desc>J7: Turn left onto the blue-blazed Kilgorie Side Trail, heading west. (the white-blazed main Bruce Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.172697" lon="-80.157832"><name>J8</name><desc>J8: Turn sharp right onto the white-blazed main Bruce Trail, heading north. (the white-blazed main Bruce Trail goes off on your left.) The next 0.5 km follows a road shoulder; keep the dog close.</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.177845" lon="-80.161186"><name>J9</name><desc>J9: Junction. Turn left to stay on the main Bruce Trail, heading south-west. (the blue-blazed Melodonna Side Trail goes off ahead.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.182302" lon="-80.162499"><name>J10</name><desc>J10: Turn right onto the blue-blazed Melodonna Side Trail, heading east. (the white-blazed main Bruce Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
