<metadata><name>Day 12 - Artaban Road, Canterbury Falls</name></metadata>
<wpt lat="43.239931" lon="-79.992508"><name>P Start/finish parking</name><desc>Parking at the end of Lions Club Rd within Dundas Valley Conservation Area</desc><sym>Parking Area</sym></wpt>
<wpt lat="43.236993" lon="-79.993222"><name>J1</name><desc>J1: Turn left onto the white-blazed main Bruce Trail, heading south-east. (the white-blazed main Bruce Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.236464" lon="-79.988415"><name>J2</name><desc>J2: Junction. Continue straight to stay on the main Bruce Trail, heading north-east. (the blue-blazed Canterbury Falls Side Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.236862" lon="-79.980440"><name>J3</name><desc>J3: Turn right onto the blue-blazed Canterbury Falls Side Trail, heading south. (the white-blazed main Bruce Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.239933" lon="-79.992742"><name>J4</name><desc>J4: You pass the start again. Keep going on the blue-blazed Artaban Road Side Trail, heading north.</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.246705" lon="-79.978588"><name>J5</name><desc>J5: Turnaround point. Turn around and retrace your steps.</desc><sym>Waypoint</sym></wpt>
