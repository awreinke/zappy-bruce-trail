<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="Claude Bruce Trail planner" xmlns="http://www.topografix.com/GPX/1/1">
<metadata><name>Day 26 - Bennett Heritage Trail, Maureen Smith, Snows Creek, Silver Creek, Eighth Line</name></metadata>
<wpt lat="43.679840" lon="-79.966419"><name>P Start/finish parking</name><desc>Roadside parking across from the Eighth Line Side Trail on Eighth Line. Free</desc><sym>Parking Area</sym></wpt>
<wpt lat="43.687350" lon="-79.990900"><name>P2 alternative parking</name><desc>Scotsdale Farm: Enter from Trafalgar Rd, 1.7 km northwest of Highway 7. Free. Joins the route near km 6.9 (0 m walk).</desc><sym>Parking Area</sym></wpt>
<wpt lat="43.692270" lon="-79.983390"><name>P3 alternative parking</name><desc>In the laneway off the west side of Eighth Line where the Bennett Heritage Trail crosses. Free. Joins the route near km 7.8 (120 m walk).</desc><sym>Parking Area</sym></wpt>
<wpt lat="43.692610" lon="-79.968430"><name>P4 alternative parking</name><desc>Silver Creek Education Centre: Enter from Fallbrook Trail northwest of the 27th Sideroad. Free. Joins the route near km 9.8 (1200 m walk).</desc><sym>Parking Area</sym></wpt>
<wpt lat="43.686280" lon="-79.975580"><name>P5 alternative parking</name><desc>Roadside parking on the eastern shoulder of Eighth Line at the southernmost intersection with…. Free. Joins the route near km 10.6 (190 m walk).</desc><sym>Parking Area</sym></wpt>
<wpt lat="43.679143" lon="-79.969333"><name>J1</name><desc>J1: Turn sharp right onto the white-blazed main Bruce Trail, heading north. (the white-blazed main Bruce Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.679648" lon="-79.971483"><name>J2</name><desc>J2: Turn left onto the blue-blazed Maureen Smith Side Trail, heading south-west. (the white-blazed main Bruce Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.677770" lon="-79.973935"><name>J3</name><desc>J3: Continue straight onto the blue-blazed Silver Creek Side Trail, heading west. (the blue-blazed Maureen Smith Side Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.674093" lon="-79.976478"><name>J4</name><desc>J4: Turnaround point. The side trail meets the white-blazed main Bruce Trail here. Turn around and retrace your steps.</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.687791" lon="-79.981866"><name>J5</name><desc>J5: Junction. Turn right to stay on the Maureen Smith Side Trail, heading north-east. (the blue-blazed Snows Creek Side Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.689966" lon="-79.980464"><name>J6</name><desc>J6: Turnaround point. Turn around and retrace your steps.</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.680256" lon="-79.990120"><name>J7</name><desc>J7: Turn sharp right onto the blue-blazed Bennett Heritage Trail, heading north-west. (the blue-blazed Snows Creek Side Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.691636" lon="-79.983985"><name>J8</name><desc>J8: Junction. Continue straight to stay on the Bennett Heritage Trail, heading north-east. (the blue-blazed Maureen Smith Side Trail goes off on your right.) There is trailhead parking here (In the laneway off the west side of Eighth Line where the Bennett Heritage Trail crosses).</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.689553" lon="-79.969478"><name>J9</name><desc>J9: Continue straight onto the white-blazed main Bruce Trail, heading south-west. (the white-blazed main Bruce Trail goes off behind you.)</desc><sym>Waypoint</sym></wpt>
