<gpx version="1.1" creator="Claude Bruce Trail planner" xmlns="http://www.topografix.com/GPX/1/1">
<metadata><name>Day 56 (stop 1 of 2) - Wilson Homestead, Avalanche Pass, Vanishing Wall</name></metadata>
<wpt lat="44.555691" lon="-80.750767"><name>P Start/finish parking</name><desc>Roadside parking at the north end of 2nd Concession S, providing access to the Silent…. Free</desc><sym>Parking Area</sym></wpt>
<wpt lat="44.560161" lon="-80.754659"><name>J1</name><desc>J1: Turn left onto the blue-blazed Avalanche Pass Side Trail, heading north. (the white-blazed main Bruce Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.563055" lon="-80.760729"><name>J2</name><desc>J2: Continue straight onto the white-blazed main Bruce Trail, heading west. (the white-blazed main Bruce Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.558759" lon="-80.768730"><name>J3</name><desc>J3: Turn left onto the blue-blazed Wilson Homestead Side Trail, heading south. (the white-blazed main Bruce Trail goes off ahead.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.560816" lon="-80.757779"><name>J4</name><desc>J4: Turn left onto the white-blazed main Bruce Trail, heading north. (the white-blazed main Bruce Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.561546" lon="-80.758280"><name>J5</name><desc>J5: Turn right onto the blue-blazed Vanishing Wall Side Trail, heading north-east. (the white-blazed main Bruce Trail goes off ahead.)</desc><sym>Waypoint</sym></wpt>
