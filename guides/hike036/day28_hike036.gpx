<gpx version="1.1" creator="Claude Bruce Trail planner" xmlns="http://www.topografix.com/GPX/1/1">
<metadata><name>Day 28 - Terra Cotta</name></metadata>
<wpt lat="43.734079" lon="-79.944033"><name>P Start/finish parking</name><desc>Roadside parking where the main Trail meets Heritage Rd</desc><sym>Parking Area</sym></wpt>
<wpt lat="43.737782" lon="-79.942374"><name>J1</name><desc>J1: Continue straight onto the blue-blazed Terra Cotta Side Trail, heading north. (the white-blazed main Bruce Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.712905" lon="-79.959184"><name>J2</name><desc>J2: Continue straight onto the white-blazed main Bruce Trail, heading west. (the white-blazed main Bruce Trail goes off ahead.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.736477" lon="-79.947364"><name>J3</name><desc>J3: Junction. Turn right to stay on the main Bruce Trail, heading south-east. (the blue-blazed Rockside Side Trail goes off on your left (optional extra: Rockside Side Trail, 1.7 km, mostly on road, not in the plan).) The next 0.4 km follows a road shoulder; keep the dog close.</desc><sym>Waypoint</sym></wpt>
