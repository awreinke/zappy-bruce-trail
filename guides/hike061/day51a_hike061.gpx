<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="Claude Bruce Trail planner" xmlns="http://www.topografix.com/GPX/1/1">
<metadata><name>Day 51 (stop 1 of 2) - Old Baldy, Mac Kirk</name></metadata>
<wpt lat="44.380250" lon="-80.535202"><name>P Start/finish parking</name><desc>Off road parking on east side of County Rd 13 will accommodate 3 cars. Free</desc><sym>Parking Area</sym></wpt>
<wpt lat="44.392190" lon="-80.518590"><name>P2 alternative parking</name><desc>Old Baldy Conservation Area: Pay parking for Conservation Area access. Paid: $10 + HST per vehicle (day). Joins the route near km 2.4 (440 m walk).</desc><sym>Parking Area</sym></wpt>
<wpt lat="44.395310" lon="-80.518500"><name>P3 alternative parking</name><desc>Roadside parking on the northern shoulder of Sideroad 7B where the main Trail enters the forest. Free. Joins the route near km 2.4 (800 m walk).</desc><sym>Parking Area</sym></wpt>
<wpt lat="44.382110" lon="-80.523072"><name>J1</name><desc>J1: Turn left onto the white-blazed main Bruce Trail, heading north. (the white-blazed main Bruce Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.385470" lon="-80.523447"><name>J2</name><desc>J2: Turn right onto the blue-blazed Mac Kirk Side Trail, heading east. (the white-blazed main Bruce Trail goes off ahead.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.388743" lon="-80.520470"><name>J3</name><desc>J3: Turn left onto the white-blazed main Bruce Trail, heading south-west. (the white-blazed main Bruce Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
