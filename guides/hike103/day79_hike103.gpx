<gpx version="1.1" creator="Claude Bruce Trail planner" xmlns="http://www.topografix.com/GPX/1/1">
<metadata><name>Day 79 - Walter Brewer, Whippoorwill, Alan Fowler, White Bluff, David Blasing, Richardson, Reed's Dump</name></metadata>
<wpt lat="45.020460" lon="-81.283790"><name>P Start/finish parking</name><desc>Bruce Trail parking at the end of the Richardson Access Trail, with access from Forty…. Free</desc><sym>Parking Area</sym></wpt>
<wpt lat="45.022174" lon="-81.280625"><name>J1</name><desc>J1: Turn left onto the white-blazed main Bruce Trail, heading north. (the white-blazed main Bruce Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="45.028472" lon="-81.274664"><name>J2</name><desc>J2: Turn left onto the blue-blazed Whippoorwill Side Trail, heading north. (the white-blazed main Bruce Trail goes off ahead.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="45.036588" lon="-81.272570"><name>J3</name><desc>J3: Turn left onto the blue-blazed Alan Fowler Side Trail, heading north. (the blue-blazed Whippoorwill Side Trail goes off on your right; the blue-blazed Walter Brewer Side Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="45.044671" lon="-81.272723"><name>J4</name><desc>J4: Continue straight onto the blue-blazed David Blasing Side Trail, heading north. (the blue-blazed Walter Brewer Side Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="45.049373" lon="-81.271539"><name>J5</name><desc>J5: Continue straight onto the white-blazed main Bruce Trail, heading east. (the white-blazed main Bruce Trail goes off on your right.) Then, turn sharp right onto the blue-blazed Reed's Dump Side Trail, heading south-east. (the white-blazed main Bruce Trail goes off ahead.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="45.048171" lon="-81.269946"><name>J6</name><desc>J6: End of the Reed's Dump Side Trail. Turn around and retrace your steps.</desc><sym>Waypoint</sym></wpt>
<wpt lat="45.035846" lon="-81.270230"><name>J7</name><desc>J7: Continue straight onto the white-blazed main Bruce Trail, heading south. (the white-blazed main Bruce Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="45.034525" lon="-81.269374"><name>J8</name><desc>J8: Turn right onto the blue-blazed White Bluff Side Trail, heading south-west. (the white-blazed main Bruce Trail goes off ahead.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="45.028781" lon="-81.269727"><name>J9</name><desc>J9: Turn sharp right onto the white-blazed main Bruce Trail, heading south-west. (the white-blazed main Bruce Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
