<gpx version="1.1" creator="Claude Bruce Trail planner" xmlns="http://www.topografix.com/GPX/1/1">
<metadata><name>Day 38 - South Outlier Loop Trail, Laidlaw, Turnbull, McCarston's Lake, Springwater</name></metadata>
<wpt lat="44.026195" lon="-80.071516"><name>P Start/finish parking</name><desc>Mono Community Centre, 200 m south of Mono Centre (County Road 8)</desc><sym>Parking Area</sym></wpt>
<wpt lat="44.031347" lon="-80.072119"><name>J1</name><desc>J1: Turn left onto the white-blazed main Bruce Trail, heading north. (the white-blazed main Bruce Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.043399" lon="-80.073828"><name>J2</name><desc>J2: Junction. Turn left to stay on the main Bruce Trail, heading south-west. (the blue-blazed Carriage Side Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.045071" lon="-80.076885"><name>J3</name><desc>J3: Turn left onto the blue-blazed McCarston's Lake Side Trail, heading west. (the white-blazed main Bruce Trail goes off ahead.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.043498" lon="-80.083949"><name>J4</name><desc>J4: Turnaround point. The side trail meets the white-blazed main Bruce Trail here. Turn around and retrace your steps.</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.044455" lon="-80.072001"><name>J5</name><desc>J5: Turn left onto the blue-blazed Walter Tovell Side Trail, heading north. (the blue-blazed Walter Tovell Side Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.045134" lon="-80.072428"><name>J6</name><desc>J6: Turn right onto the blue-blazed Carriage Side Trail, heading north-east. (the blue-blazed Walter Tovell Side Trail goes off ahead.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.046460" lon="-80.069374"><name>J7</name><desc>J7: Turn right onto the blue-blazed South Outlier Connector, heading south. (the blue-blazed Carriage Side Trail goes off ahead.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.044806" lon="-80.068663"><name>J8</name><desc>J8: Turn left onto the blue-blazed South Outlier Loop Trail, heading east. (the blue-blazed South Outlier Loop Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.031395" lon="-80.064768"><name>J9</name><desc>J9: Junction. Turn right to stay on the South Outlier Loop Trail, heading west. (the blue-blazed Whitetail Refuge Side Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.030784" lon="-80.068122"><name>J10</name><desc>J10: Junction. Turn left to stay on the South Outlier Loop Trail, heading south. (the blue-blazed South Outlier Loop Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.029306" lon="-80.069106"><name>J11</name><desc>J11: Turn left onto the white-blazed main Bruce Trail, heading south. (the white-blazed main Bruce Trail goes off ahead; the blue-blazed Walter Tovell Side Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.027014" lon="-80.068530"><name>J12</name><desc>J12: Junction. Continue straight to stay on the main Bruce Trail, heading south. (the blue-blazed Laidlaw Side Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.025963" lon="-80.065414"><name>J13</name><desc>J13: Junction. Turn right to stay on the main Bruce Trail, heading south-east. (the blue-blazed Turnbull Side Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.023185" lon="-80.063761"><name>J14</name><desc>J14: Junction. Continue straight to stay on the main Bruce Trail, heading south-east. (the blue-blazed Turnbull Side Trail goes off ahead.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.022479" lon="-80.063286"><name>J15</name><desc>J15: Turn right onto the blue-blazed Springwater Side Trail, heading south-west. (the white-blazed main Bruce Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.021788" lon="-80.061350"><name>J16</name><desc>J16: Turnaround point. The side trail meets the white-blazed main Bruce Trail here. Turn around and retrace your steps.</desc><sym>Waypoint</sym></wpt>
