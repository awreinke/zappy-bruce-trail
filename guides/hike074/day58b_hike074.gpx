<gpx version="1.1" creator="Claude Bruce Trail planner" xmlns="http://www.topografix.com/GPX/1/1">
<metadata><name>Day 58 (stop 2 of 2) - Merle Gunby, Memorial Forest</name></metadata>
<wpt lat="44.560754" lon="-80.990675"><name>P Start/finish parking</name><desc>Grey-Bruce Tourist Information Office: Enter from Hwy 6, just north of the junction of…. Free</desc><sym>Parking Area</sym></wpt>
<wpt lat="44.568130" lon="-80.977040"><name>P2 alternative parking</name><desc>Roadside parking at the end of Young's Dr. Free. Joins the route near km 3.0 (0 m walk).</desc><sym>Parking Area</sym></wpt>
<wpt lat="44.560811" lon="-80.990090"><name>J1</name><desc>J1: Junction. Continue straight to stay on the Merle Gunby Side Trail, heading north-east. (the blue-blazed Merle Gunby Side Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.560405" lon="-80.983555"><name>J2</name><desc>J2: Turn sharp left onto the white-blazed main Bruce Trail, heading north-east. (the blue-blazed Merle Gunby Side Trail goes off ahead; the white-blazed main Bruce Trail goes off ahead.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.569128" lon="-80.978124"><name>J3</name><desc>J3: Turn right onto the blue-blazed Memorial Forest Side Trail, heading south-east. (the white-blazed main Bruce Trail goes off ahead.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.568011" lon="-80.978163"><name>J4</name><desc>J4: Junction. Turn left to stay on the Memorial Forest Side Trail, heading east. (the blue-blazed Memorial Forest Side Trail goes off ahead.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.568029" lon="-80.977218"><name>J5</name><desc>J5: End of the Memorial Forest Side Trail. There is trailhead parking here (Roadside parking at the end of Young's Dr). Turn around and retrace your steps.</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.559334" lon="-80.984160"><name>J6</name><desc>J6: Continue straight onto the white-blazed main Bruce Trail, heading north-east. (the white-blazed main Bruce Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.559523" lon="-80.986338"><name>J7</name><desc>J7: Junction. Turn right to stay on the Merle Gunby Side Trail, heading north-west. (the blue-blazed Merle Gunby Side Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
