<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="Claude Bruce Trail planner" xmlns="http://www.topografix.com/GPX/1/1">
<metadata><name>Day 61 (stop 2 of 3) - Nels Maher, Tumbled Rocks, Edmonstone, Dodds Hill</name></metadata>
<wpt lat="44.747360" lon="-80.932857"><name>P Start/finish parking</name><desc>Parking for several cars on Kemble Rock Rd at the Nels Maher Side Trail</desc><sym>Parking Area</sym></wpt>
<wpt lat="44.747555" lon="-80.929270"><name>J1</name><desc>J1: Continue straight onto the white-blazed main Bruce Trail, heading north-east. (the white-blazed main Bruce Trail goes off behind you.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.756347" lon="-80.923663"><name>J2</name><desc>J2: Continue straight onto the blue-blazed Tumbled Rocks Side Trail, heading north. (the white-blazed main Bruce Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.761819" lon="-80.922784"><name>J3</name><desc>J3: Turn right onto the blue-blazed Dodds Hill Side Trail, heading west. (the white-blazed main Bruce Trail goes off ahead; the white-blazed main Bruce Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.761613" lon="-80.924250"><name>J4</name><desc>J4: Turnaround point. Turn around and retrace your steps.</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.745324" lon="-80.931951"><name>J5</name><desc>J5: Turn right onto the blue-blazed Nels Maher Side Trail, heading north-west. (the white-blazed main Bruce Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.747404" lon="-80.932909"><name>J6</name><desc>J6: You pass the start again. Keep going on the blue-blazed Nels Maher Side Trail, heading south-west.</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.747840" lon="-80.940778"><name>J7</name><desc>J7: Turnaround point. The side trail meets the white-blazed main Bruce Trail here. Turn around and retrace your steps.</desc><sym>Waypoint</sym></wpt>
