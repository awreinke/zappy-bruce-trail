<gpx version="1.1" creator="Claude Bruce Trail planner" xmlns="http://www.topografix.com/GPX/1/1">
<metadata><name>Day 44 - Mad River, Hamilton Bros., Betty Carter, Mad River-02.</name></metadata>
<wpt lat="44.342784" lon="-80.210628"><name>P Start/finish parking</name><desc>Accessible only from Con 10 South, this small parking area off 15/16 Sideroad is provided…</desc><sym>Parking Area</sym></wpt>
<wpt lat="44.337877" lon="-80.208320"><name>J1</name><desc>J1: Turn left onto the blue-blazed Betty Carter Side Trail, heading east. (the white-blazed main Bruce Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.339836" lon="-80.198634"><name>J2</name><desc>J2: Continue straight onto the white-blazed main Bruce Trail, heading north-east. (the white-blazed main Bruce Trail goes off on your right; the blue-blazed Hamilton Bros. Side Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.346951" lon="-80.193970"><name>J3</name><desc>J3: Junction. Turn left to stay on the main Bruce Trail, heading west. (the blue-blazed Mad River Side Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.356182" lon="-80.202050"><name>J4</name><desc>J4: Turn sharp right onto the blue-blazed Mad River Side Trail-02., heading south-east. (the white-blazed main Bruce Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.354549" lon="-80.200278"><name>J5</name><desc>J5: Turn left onto the blue-blazed Mad River Side Trail, heading south-east.</desc><sym>Waypoint</sym></wpt>
