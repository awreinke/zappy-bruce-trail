<gpx version="1.1" creator="Claude Bruce Trail planner" xmlns="http://www.topografix.com/GPX/1/1">
<metadata><name>Day 73 - Ivan Lemcke, Rush Cove Rd, Ivan Lemcke Connector</name></metadata>
<wpt lat="44.950991" lon="-81.168243"><name>P Start/finish parking</name><desc>A large area on the west side of Rush Cove Rd, 750 metres north of Scenic Caves Rd. Free</desc><sym>Parking Area</sym></wpt>
<wpt lat="44.953785" lon="-81.166420"><name>J1</name><desc>J1: Turn left onto the blue-blazed Ivan Lemcke Side Trail, heading north. (the blue-blazed Rush Cove Rd Side Trail goes off ahead.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.958816" lon="-81.173357"><name>J2</name><desc>J2: Junction. Continue straight to stay on the Ivan Lemcke Side Trail, heading west. (the blue-blazed Ivan Lemcke Connector Side Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.958113" lon="-81.179555"><name>J3</name><desc>J3: Turn right onto the white-blazed main Bruce Trail, heading east. (the white-blazed main Bruce Trail goes off ahead.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.959510" lon="-81.173030"><name>J4</name><desc>J4: Turn right onto the blue-blazed Ivan Lemcke Connector Side Trail, heading south. (the white-blazed main Bruce Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
