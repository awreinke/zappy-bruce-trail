<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="Claude Bruce Trail planner" xmlns="http://www.topografix.com/GPX/1/1">
<metadata><name>Day 69 - Lloyd Hayward, Knapp, Jones Bluff, Great Egret</name></metadata>
<wpt lat="44.877725" lon="-81.071134"><name>P Start/finish parking</name><desc>Several spaces are available where the Jones Bluff Side Trail leaves the Trail. Free</desc><sym>Parking Area</sym></wpt>
<wpt lat="44.873790" lon="-81.075040"><name>P2 alternative parking</name><desc>Crooked Toe Parking: Courtesy of Chippewas of Nawash. Free. Joins the route near km 2.3 (0 m walk).</desc><sym>Parking Area</sym></wpt>
<wpt lat="44.862610" lon="-81.067960"><name>P3 alternative parking</name><desc>Roadside Parking at the bend on the grassy shoulder of Coveney's Rd. Free. Joins the route near km 7.6 (580 m walk).</desc><sym>Parking Area</sym></wpt>
<wpt lat="44.882143" lon="-81.076402"><name>J1</name><desc>J1: Turnaround point. The side trail meets the white-blazed main Bruce Trail here. Turn around and retrace your steps.</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.877781" lon="-81.070889"><name>J2</name><desc>J2: You pass the start again. Keep going on the white-blazed main Bruce Trail, heading south-west.</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.873610" lon="-81.074986"><name>J3</name><desc>J3: Junction. Continue straight to stay on the main Bruce Trail, heading south. (the blue-blazed Knapp Side Trail goes off on your left.) There is trailhead parking here (Crooked Toe Parking: Courtesy of Chippewas of Nawash).</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.871575" lon="-81.076274"><name>J4</name><desc>J4: Turn right onto the blue-blazed Lloyd Hayward Side Trail, heading west. (the white-blazed main Bruce Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.879095" lon="-81.085122"><name>J5</name><desc>J5: End of the Lloyd Hayward Side Trail. Turn around and retrace your steps.</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.870198" lon="-81.075791"><name>J6</name><desc>J6: Continue straight onto the blue-blazed Great Egret Side Trail, heading south. (the white-blazed main Bruce Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.869765" lon="-81.076601"><name>J7</name><desc>J7: End of the Great Egret Side Trail. Turn around and retrace your steps.</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.867429" lon="-81.070459"><name>J8</name><desc>J8: Junction. Turn left to stay on the main Bruce Trail, heading north. (the blue-blazed Coveney's Side Trail goes off on your right.) The next 0.0 km follows an unopened road allowance (rough track, no traffic).</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.869258" lon="-81.067499"><name>J9</name><desc>J9: Turn sharp left onto the blue-blazed Knapp Side Trail, heading north-west. (the white-blazed main Bruce Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
