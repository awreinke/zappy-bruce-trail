<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="Claude Bruce Trail planner" xmlns="http://www.topografix.com/GPX/1/1">
<metadata><name>Day 52 - East Mountain, Valley Crossover, Valley Vistas, Rockface, East Eagle's Summit, Cascades, Pond View, Erratic View</name></metadata>
<wpt lat="44.363929" lon="-80.531458"><name>P Start/finish parking</name><desc>Beaver Valley Lookout: on the west side of Grey Rd 13, roughly 750 m north of the Bruce…. Free</desc><sym>Parking Area</sym></wpt>
<wpt lat="44.357380" lon="-80.543330"><name>P2 alternative parking</name><desc>Summer parking permitted in the main ski club parking lot, located between the two bridges on…. Free. Joins the route near km 7.6 (750 m walk).</desc><sym>Parking Area</sym></wpt>
<wpt lat="44.364298" lon="-80.530785"><name>J1</name><desc>J1: Turn right onto the blue-blazed Cascades Side Trail, heading south-east. (the blue-blazed Valley Vistas Side Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.362462" lon="-80.528540"><name>J2</name><desc>J2: Junction. Turn left to stay on the Cascades Side Trail, heading north. (the blue-blazed Rockface Side Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.362548" lon="-80.527686"><name>J3</name><desc>J3: Turn left onto the white-blazed main Bruce Trail, heading north. (the white-blazed main Bruce Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.363376" lon="-80.527504"><name>J4</name><desc>J4: Turn right onto the blue-blazed Erratic View Side Trail, heading east. (the white-blazed main Bruce Trail goes off ahead.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.363291" lon="-80.526601"><name>J5</name><desc>J5: Turnaround point. Turn around and retrace your steps.</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.364841" lon="-80.527116"><name>J6</name><desc>J6: Turn right onto the blue-blazed Pond View Side Trail, heading east. (the white-blazed main Bruce Trail goes off ahead.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.364331" lon="-80.525538"><name>J7</name><desc>J7: Turn left onto the blue-blazed East Mountain Side Trail, heading east. (the blue-blazed East Mountain Side Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.365205" lon="-80.523586"><name>J8</name><desc>J8: Junction. Turn right to stay on the East Mountain Side Trail, heading south-east. (the blue-blazed East Eagle's Summit Side Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.372172" lon="-80.525375"><name>J9</name><desc>J9: Turn left onto the white-blazed main Bruce Trail, heading south-west. (the white-blazed main Bruce Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.367887" lon="-80.525585"><name>J10</name><desc>J10: Turn left onto the blue-blazed East Eagle's Summit Side Trail, heading east. (the white-blazed main Bruce Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.362194" lon="-80.526936"><name>J11</name><desc>J11: Continue straight onto the white-blazed main Bruce Trail, heading south. (the white-blazed main Bruce Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.357362" lon="-80.529798"><name>J12</name><desc>J12: Turn sharp right onto the blue-blazed Valley Crossover Side Trail, heading north. (the white-blazed main Bruce Trail goes off ahead.) The next 0.1 km follows a road shoulder; keep the dog close.</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.366294" lon="-80.527782"><name>J13</name><desc>J13: Turn right onto the blue-blazed Valley Vistas Side Trail, heading north-east. (the blue-blazed Valley Vistas Side Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.367046" lon="-80.526910"><name>J14</name><desc>J14: Turnaround point. The side trail meets the white-blazed main Bruce Trail here. Turn around and retrace your steps.</desc><sym>Waypoint</sym></wpt>
<trk><name>Day 52 - East Mountain, Valley Crossover, Valley Vistas, Rockface, East Eagle's Summit, Cascades, Pond View, Erratic View (11.0 km)</name><trkseg>
