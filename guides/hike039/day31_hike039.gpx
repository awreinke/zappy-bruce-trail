<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="Claude Bruce Trail planner" xmlns="http://www.topografix.com/GPX/1/1">
<metadata><name>Day 31 - Songbird, Paris Morain</name></metadata>
<wpt lat="43.909402" lon="-79.920418"><name>P Start/finish parking</name><desc>Roadside parking on the west side of Airport Road, across from Finnerty Sideroad. Free</desc><sym>Parking Area</sym></wpt>
<wpt lat="43.894250" lon="-79.922520"><name>P2 alternative parking</name><desc>Roadside parking on Mountainview Rd at the Mountainview Road Access Trail. Free. Joins the route near km 3.2 (0 m walk).</desc><sym>Parking Area</sym></wpt>
<wpt lat="43.884910" lon="-79.920310"><name>P3 alternative parking</name><desc>There are a number of roadside parking opportunities along Escarpment Sideroad where wide…. Free. Joins the route near km 4.6 (50 m walk).</desc><sym>Parking Area</sym></wpt>
<wpt lat="43.894030" lon="-79.921870"><name>J1</name><desc>J1: Junction. Turn right to stay on the main Bruce Trail, heading south-west. (the blue-blazed Paris Moraine Side Trail goes off ahead.) There is trailhead parking here (Roadside parking on Mountainview Rd at the Mountainview Road Access Trail).</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.888426" lon="-79.926279"><name>J2</name><desc>J2: Turn left onto the blue-blazed Paris Moraine Side Trail, heading south-east. (the white-blazed main Bruce Trail goes off ahead.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.884459" lon="-79.920898"><name>J3</name><desc>J3: Turnaround point. Turn around and retrace your steps.</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.909495" lon="-79.920582"><name>J4</name><desc>J4: You pass the start again. Keep going on the blue-blazed Songbird Side Trail, heading south-east.</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.903337" lon="-79.918739"><name>J5</name><desc>J5: Junction. Turn sharp left to stay on the Songbird Side Trail, heading south. (the blue-blazed Songbird Side Trail goes off ahead.) This is a short excursion (about 810 m in all): walk the whole Songbird Side Trail, including the short loop or branch near its end (see the map), and come back to this junction.</desc><sym>Waypoint</sym></wpt>
