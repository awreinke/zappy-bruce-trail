<gpx version="1.1" creator="Claude Bruce Trail planner" xmlns="http://www.topografix.com/GPX/1/1">
<metadata><name>Day 35 - Tom East, Goodyear Memorial, Upland, Rushing River</name></metadata>
<wpt lat="43.959916" lon="-80.070494"><name>P Start/finish parking</name><desc>BTC Parking Area on the east side of 1st Line EHS</desc><sym>Parking Area</sym></wpt>
<wpt lat="43.960347" lon="-80.067852"><name>J1</name><desc>J1: Continue straight onto the blue-blazed Upland Side Trail, heading north. (the blue-blazed Goodyear Memorial Side Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.961524" lon="-80.059869"><name>J2</name><desc>J2: Turn right onto the blue-blazed Goodyear Memorial Side Trail, heading north-east. (the blue-blazed Goodyear Memorial Side Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.961328" lon="-80.055671"><name>J3</name><desc>J3: Turn left onto the white-blazed main Bruce Trail, heading north. (the white-blazed main Bruce Trail goes off on your right.) There is trailhead parking here (Roadside parking on the west side of 2nd Line EHS). The next 1.2 km follows a road shoulder; keep the dog close.</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.971440" lon="-80.058067"><name>J4</name><desc>J4: Junction. Turn left to stay on the main Bruce Trail, heading west. (the blue-blazed Hockley Road Side Trail goes off on your right (optional extra: Hockley Road Side Trail, 0.2 km, mostly on road, not in the plan).)</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.972771" lon="-80.058918"><name>J5</name><desc>J5: Junction. Turn left to stay on the main Bruce Trail, heading west. (the blue-blazed Tom East Side Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.984481" lon="-80.060729"><name>J6</name><desc>J6: Turn right onto the blue-blazed Tom East Side Trail, heading east. (the white-blazed main Bruce Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.965093" lon="-80.065721"><name>J7</name><desc>J7: Continue straight onto the blue-blazed Rushing River Side Trail, heading north-west. (the blue-blazed Goodyear Memorial Side Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.966613" lon="-80.066657"><name>J8</name><desc>J8: End of the Rushing River Side Trail. Turn around and retrace your steps.</desc><sym>Waypoint</sym></wpt>
