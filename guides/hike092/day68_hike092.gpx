<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="Claude Bruce Trail planner" xmlns="http://www.topografix.com/GPX/1/1">
<metadata><name>Day 68 - Colpoy's Bluff, Whicher, Mallory Beach, Crawford Drive, Gatis</name></metadata>
<wpt lat="44.801588" lon="-81.088626"><name>P Start/finish parking</name><desc>Limited parking on the north side of the road, providing access to the Mallory Beach Side…. Free</desc><sym>Parking Area</sym></wpt>
<wpt lat="44.783250" lon="-81.124350"><name>P2 alternative parking</name><desc>Park on the east shoulder near the stile, taking care not to block any laneway. Free. Joins the route near km 3.5 (1010 m walk).</desc><sym>Parking Area</sym></wpt>
<wpt lat="44.819240" lon="-81.072800"><name>P3 alternative parking</name><desc>Several cars may park at the north end of the Crawford Drive Side Trail. Free. Joins the route near km 9.2 (0 m walk).</desc><sym>Parking Area</sym></wpt>
<wpt lat="44.801896" lon="-81.091571"><name>J1</name><desc>J1: Continue straight onto the white-blazed main Bruce Trail, heading south-west. (the white-blazed main Bruce Trail goes off behind you; the blue-blazed Mallory Beach Side Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.796740" lon="-81.099338"><name>J2</name><desc>J2: Turn right onto the blue-blazed Gatis Side Trail, heading west. (the white-blazed main Bruce Trail goes off ahead.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.797800" lon="-81.102197"><name>J3</name><desc>J3: Turn left onto the blue-blazed Colpoy's Bluff Side Trail, heading west. (the blue-blazed Colpoy's Bluff Side Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.793058" lon="-81.108915"><name>J4</name><desc>J4: Turn left onto the blue-blazed Whicher Side Trail, heading south-east. (the blue-blazed Whicher Side Trail goes off ahead.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.791403" lon="-81.107875"><name>J5</name><desc>J5: Turn right onto the white-blazed main Bruce Trail, heading south-west. (the white-blazed main Bruce Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.785795" lon="-81.116132"><name>J6</name><desc>J6: Turn sharp right onto the blue-blazed Whicher Side Trail, heading north-west. (the white-blazed main Bruce Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.787262" lon="-81.117171"><name>J7</name><desc>J7: Junction. Turn right to stay on the Whicher Side Trail, heading north-east. (the blue-blazed Whicher Side Trail (disappearing stream) goes off ahead.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.803624" lon="-81.092218"><name>J8</name><desc>J8: Junction. Continue straight to stay on the Colpoy's Bluff Side Trail, heading north-east. (the blue-blazed Mallory Beach Side Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.816692" lon="-81.071649"><name>J9</name><desc>J9: Turn left onto the blue-blazed Crawford Drive Side Trail, heading north. (the blue-blazed Crawford Drive Side Trail goes off on your right.) This is a short excursion (about 760 m in all): walk the whole Crawford Drive Side Trail, including the short loop or branch near its end (see the map), and come back to this junction. The next 0.8 km follows an unopened road allowance (rough track, no traffic).</desc><sym>Waypoint</sym></wpt>
<trk><name>Day 68 - Colpoy's Bluff, Whicher, Mallory Beach, Crawford Drive, Gatis (12.4 km)</name><trkseg>
