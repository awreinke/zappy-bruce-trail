<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="Claude Bruce Trail planner" xmlns="http://www.topografix.com/GPX/1/1">
<metadata><name>Day 32 (stop 1 of 2) - Songbird, Meltwater</name></metadata>
<wpt lat="43.909402" lon="-79.920418"><name>P Start/finish parking</name><desc>Roadside parking on the west side of Airport Road, across from Finnerty Sideroad. Free</desc><sym>Parking Area</sym></wpt>
<wpt lat="43.907130" lon="-79.922730"><name>J1</name><desc>J1: Continue straight onto the blue-blazed Meltwater Side Trail, heading south-west. (the white-blazed main Bruce Trail goes off behind you.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.904240" lon="-79.923716"><name>J2</name><desc>J2: Turnaround point. The side trail meets the white-blazed main Bruce Trail here. Turn around and retrace your steps.</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.909495" lon="-79.920582"><name>J3</name><desc>J3: You pass the start again. Keep going on the blue-blazed Songbird Side Trail, heading south-east.</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.903337" lon="-79.918739"><name>J4</name><desc>J4: Junction. Continue straight to stay on the Songbird Side Trail, heading north-west. (the blue-blazed Songbird Side Trail goes off on your left.) This is a short excursion (about 810 m in all): walk the whole Songbird Side Trail, including the short loop or branch near its end (see the map), and come back to this junction.</desc><sym>Waypoint</sym></wpt>
