<gpx version="1.1" creator="Claude Bruce Trail planner" xmlns="http://www.topografix.com/GPX/1/1">
<metadata><name>Day 33 (stop 1 of 2) - Hockleycrest, Darcy's, Harmony, Hockley Hollow, Hockleycrest Shortcut</name></metadata>
<wpt lat="43.974055" lon="-79.984988"><name>P Start/finish parking</name><desc>Parking Lot on Mono 5 Sideroad on the north side of the road where the Trail crosses</desc><sym>Parking Area</sym></wpt>
<wpt lat="43.976268" lon="-79.984717"><name>J1</name><desc>J1: Continue straight onto the blue-blazed Harmony Side Trail, heading north. (the white-blazed main Bruce Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.977181" lon="-79.985150"><name>J2</name><desc>J2: Turn left onto the white-blazed main Bruce Trail, heading north-west. (the white-blazed main Bruce Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.980860" lon="-79.985774"><name>J3</name><desc>J3: Junction. Continue straight to stay on the main Bruce Trail, heading north. (the blue-blazed Hockleycrest Side Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.984126" lon="-79.986516"><name>J4</name><desc>J4: Continue straight onto the blue-blazed Hockley Hollow Side Trail, heading north. (the white-blazed main Bruce Trail goes off ahead.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.984658" lon="-79.986594"><name>J5</name><desc>J5: End of the Hockley Hollow Side Trail. Turn around and retrace your steps.</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.984556" lon="-79.988254"><name>J6</name><desc>J6: Continue straight onto the blue-blazed Hockleycrest Shortcut Side Trail, heading west. (the white-blazed main Bruce Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.987440" lon="-79.991697"><name>J7</name><desc>J7: Continue straight onto the blue-blazed Hockleycrest Side Trail, heading south-west. (the white-blazed main Bruce Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.976689" lon="-79.982453"><name>J8</name><desc>J8: Turn right onto the blue-blazed Darcy's Side Trail, heading south-west. (the white-blazed main Bruce Trail goes off behind you.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.973679" lon="-79.980061"><name>J9</name><desc>J9: End of the Darcy's Side Trail. Turn around and retrace your steps.</desc><sym>Waypoint</sym></wpt>
<trk><name>Day 33 (stop 1 of 2) - Hockleycrest, Darcy's, Harmony, Hockley Hollow, Hockleycrest Shortcut (6.1 km)</name><trkseg>
