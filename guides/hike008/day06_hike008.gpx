<metadata><name>Day 6 - The Twelve, The Twelve-01.</name></metadata>
<wpt lat="43.134275" lon="-79.249280"><name>P Start/finish parking</name><desc>Parking Area: Providing access to the The Twelve Side Trail north of Glendale Ave</desc><sym>Parking Area</sym></wpt>
<wpt lat="43.154357" lon="-79.243242"><name>J1</name><desc>J1: End of the The Twelve Side Trail. Turn around and retrace your steps.</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.134421" lon="-79.249173"><name>J2</name><desc>J2: You pass the start again. Keep going on the blue-blazed The Twelve Side Trail, heading west.</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.133362" lon="-79.250556"><name>J3</name><desc>J3: Continue straight onto the blue-blazed The Twelve Side Trail-01., heading south.</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.121591" lon="-79.258710"><name>J4</name><desc>J4: Turn left onto the blue-blazed The Twelve Side Trail, heading east. The next 0.3 km follows a road shoulder; keep the dog close.</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.119231" lon="-79.258064"><name>J5</name><desc>J5: Turnaround point. The side trail meets the white-blazed main Bruce Trail here. Turn around and retrace your steps.</desc><sym>Waypoint</sym></wpt>
