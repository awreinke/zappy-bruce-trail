<gpx version="1.1" creator="Claude Bruce Trail planner" xmlns="http://www.topografix.com/GPX/1/1">
<metadata><name>Day 8 (stop 2 of 2) - Lower Falls, Louth, Staff Avenue, Midway</name></metadata>
<wpt lat="43.121706" lon="-79.351235"><name>P Start/finish parking</name><desc>Louth Conservation Area: Enter from Staff Ave, 500 m north of Pelham Rd (Regional Rd 69)</desc><sym>Parking Area</sym></wpt>
<wpt lat="43.123728" lon="-79.349371"><name>J1</name><desc>J1: Turn right onto the white-blazed main Bruce Trail, heading east. (the white-blazed main Bruce Trail goes off behind you.) Then, turn right onto the blue-blazed Louth Side Trail, heading south. (the white-blazed main Bruce Trail goes off ahead.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.123330" lon="-79.344256"><name>J2</name><desc>J2: Continue straight onto the white-blazed main Bruce Trail, heading north-west. (the white-blazed main Bruce Trail goes off behind you.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.125352" lon="-79.345886"><name>J3</name><desc>J3: Turn right onto the blue-blazed Lower Falls Side Trail, heading north-east. (the white-blazed main Bruce Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.125470" lon="-79.347210"><name>J4</name><desc>J4: Turn right onto the blue-blazed Midway Side Trail, heading south-west. (the white-blazed main Bruce Trail goes off on your right; the white-blazed main Bruce Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.123958" lon="-79.348443"><name>J5</name><desc>J5: Turn right onto the white-blazed main Bruce Trail, heading south-west. (the white-blazed main Bruce Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
