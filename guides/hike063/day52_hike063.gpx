<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="Claude Bruce Trail planner" xmlns="http://www.topografix.com/GPX/1/1">
<metadata><name>Day 52 - Upper Beaver Valley, Uplands Meadow, Boyne River Crossover, East Back Line, South Boardwalk</name></metadata>
<wpt lat="44.279842" lon="-80.546168"><name>P Start/finish parking</name><desc>Limited roadside parking on the south side of East Back Line. Free</desc><sym>Parking Area</sym></wpt>
<wpt lat="44.292770" lon="-80.540180"><name>P2 alternative parking</name><desc>Roadside Parking on Lower Valley Rd where the Hogg's Falls Upper Side Trail enters the forest,…. Free. Joins the route near km 3.7 (0 m walk).</desc><sym>Parking Area</sym></wpt>
<wpt lat="44.285310" lon="-80.543080"><name>P3 alternative parking</name><desc>Hogg's Falls Parking Lot: On the west side of Lower Valley Rd, roughly 750 metres north of…. Free. Joins the route near km 5.5 (0 m walk).</desc><sym>Parking Area</sym></wpt>
<wpt lat="44.280983" lon="-80.546010"><name>J1</name><desc>J1: Continue straight onto the white-blazed main Bruce Trail, heading north-east. (the white-blazed main Bruce Trail goes off ahead.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.281471" lon="-80.544139"><name>J2</name><desc>J2: Junction. Turn left to stay on the main Bruce Trail, heading north-east. (the blue-blazed South Boardwalk Side Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.284428" lon="-80.542788"><name>J3</name><desc>J3: Turn right onto the blue-blazed Uplands Meadow Side Trail, heading east. (the white-blazed main Bruce Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.284211" lon="-80.535922"><name>J4</name><desc>J4: Turn right onto the white-blazed main Bruce Trail, heading east. (the white-blazed main Bruce Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.292131" lon="-80.533127"><name>J5</name><desc>J5: Turn left onto the blue-blazed Upper Beaver Valley Side Trail, heading west. (the white-blazed main Bruce Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.286581" lon="-80.538823"><name>J6</name><desc>J6: Turn right onto the white-blazed main Bruce Trail, heading west. (the white-blazed main Bruce Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.286878" lon="-80.543270"><name>J7</name><desc>J7: Turn right onto the blue-blazed Boyne River Crossover Side Trail, heading north-east. (the white-blazed main Bruce Trail goes off ahead.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.288126" lon="-80.542296"><name>J8</name><desc>J8: Turnaround point. The side trail meets the white-blazed main Bruce Trail here. Turn around and retrace your steps.</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.280858" lon="-80.543894"><name>J9</name><desc>J9: End of the South Boardwalk Side Trail. Turn around and retrace your steps.</desc><sym>Waypoint</sym></wpt>
<trk><name>Day 52 - Upper Beaver Valley, Uplands Meadow, Boyne River Crossover, East Back Line, South Boardwalk (6.4 km)</name><trkseg>
