<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="Claude Bruce Trail planner" xmlns="http://www.topografix.com/GPX/1/1">
<metadata><name>Day 9 - Twenty Valley, Upper Falls, Jim Rainforth</name></metadata>
<wpt lat="43.142022" lon="-79.372672"><name>P Start/finish parking</name><desc>Parking Area: On the north side of King Street (Hwy 81). Free</desc><sym>Parking Area</sym></wpt>
<wpt lat="43.151920" lon="-79.373380"><name>P2 alternative parking</name><desc>Twenty First Street parking at the north end of the Twenty Valley Side Trail (new Dec 2025,…. Fee unclear. Joins the route near km 1.2 (0 m walk).</desc><sym>Parking Area</sym></wpt>
<wpt lat="43.139160" lon="-79.373910"><name>P3 alternative parking</name><desc>Off Road Parking: On the shoulder of Glen Rd. Free. Joins the route near km 3.1 (0 m walk).</desc><sym>Parking Area</sym></wpt>
<wpt lat="43.133590" lon="-79.385230"><name>P4 alternative parking</name><desc>Ball's Falls Conservation Area: Enter from Sixth Ave, 1 km north of Seventh Ave and 500 m east…. Paid: $15 per vehicle/driver (+$5 each additional adult); $9 off-season unattended. Joins the route near km 7.3 (260 m walk).</desc><sym>Parking Area</sym></wpt>
<wpt lat="43.151923" lon="-79.373382"><name>J1</name><desc>J1: End of the Twenty Valley Side Trail. There is trailhead parking here (Twenty First Street parking at the north end of the Twenty Valley Side Trail (new Dec…). Turn around and retrace your steps.</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.142226" lon="-79.372791"><name>J2</name><desc>J2: You pass the start again. Keep going on the blue-blazed Twenty Valley Side Trail, heading west.</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.138479" lon="-79.374661"><name>J3</name><desc>J3: Turn sharp left onto the white-blazed main Bruce Trail, heading north. (the white-blazed main Bruce Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.137054" lon="-79.368157"><name>J4</name><desc>J4: Turn left onto the blue-blazed Jim Rainforth Side Trail, heading north-east. (the white-blazed main Bruce Trail goes off ahead.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.135795" lon="-79.360678"><name>J5</name><desc>J5: Turnaround point. The side trail meets the white-blazed main Bruce Trail here. Turn around and retrace your steps.</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.133520" lon="-79.382464"><name>J6</name><desc>J6: Continue straight onto the blue-blazed Upper Falls Side Trail, heading south-west. (the white-blazed main Bruce Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.132411" lon="-79.384264"><name>J7</name><desc>J7: Junction. Continue straight to stay on the Upper Falls Side Trail, heading south. (the blue-blazed Upper Falls Side Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
