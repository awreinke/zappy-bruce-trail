<gpx version="1.1" creator="Claude Bruce Trail planner" xmlns="http://www.topografix.com/GPX/1/1">
<metadata><name>Day 24 (stop 1 of 2) - Todd Bardes Meadowland, Ridge, Ancient Maple, Limehouse</name></metadata>
<wpt lat="43.632448" lon="-79.973355"><name>P Start/finish parking</name><desc>Limehouse Conservation Area: Parking at the baseball diamonds. Free</desc><sym>Parking Area</sym></wpt>
<wpt lat="43.636860" lon="-79.979820"><name>P2 alternative parking</name><desc>Roadside parking in Limehouse at the intersection of 22 Sideroad and the Fifth Line. Free. Joins the route near km 1.5 (0 m walk).</desc><sym>Parking Area</sym></wpt>
<wpt lat="43.642390" lon="-79.987690"><name>P3 alternative parking</name><desc>Fifth Line parking at the Ancient Maple Side Trail (new June 2025, BTC Map 12; location traced…. Fee unclear. Joins the route near km 4.0 (0 m walk).</desc><sym>Parking Area</sym></wpt>
<wpt lat="43.633767" lon="-79.970853"><name>J1</name><desc>J1: Turn left onto the white-blazed main Bruce Trail, heading west. (the white-blazed main Bruce Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.636605" lon="-79.976036"><name>J2</name><desc>J2: Junction. Turn left to stay on the main Bruce Trail, heading west. (the blue-blazed Black Creek Side Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.636915" lon="-79.979440"><name>J3</name><desc>J3: Junction. Turn right to stay on the main Bruce Trail, heading north. (the blue-blazed Canada Goose Side Trail goes off ahead.) There is trailhead parking here (Roadside parking in Limehouse at the intersection of 22 Sideroad and the Fifth Line). The next 0.4 km follows a road shoulder; keep the dog close.</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.642803" lon="-79.979427"><name>J4</name><desc>J4: Junction. Turn left to stay on the main Bruce Trail, heading north-west. (the blue-blazed Todd Bardes Meadowland Side Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.645434" lon="-79.978627"><name>J5</name><desc>J5: Junction. Turn left to stay on the main Bruce Trail, heading north-west. (the blue-blazed Todd Bardes Meadowland Side Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.646031" lon="-79.979881"><name>J6</name><desc>J6: Turn right onto the blue-blazed Ridge Side Trail, heading north-west. (the white-blazed main Bruce Trail goes off ahead.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.646408" lon="-79.982789"><name>J7</name><desc>J7: Turn left onto the white-blazed main Bruce Trail, heading south-west.</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.645881" lon="-79.983343"><name>J8</name><desc>J8: Junction. Continue straight to stay on the main Bruce Trail, heading south. (the white-blazed main Bruce Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.644261" lon="-79.984424"><name>J9</name><desc>J9: Turn right onto the blue-blazed Ancient Maple Side Trail, heading west. (the white-blazed main Bruce Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.642390" lon="-79.987692"><name>J10</name><desc>J10: End of the Ancient Maple Side Trail. There is trailhead parking here (Fifth Line parking at the Ancient Maple Side Trail (new June 2025, BTC Map 12; location…). Turn around and retrace your steps.</desc><sym>Waypoint</sym></wpt>
