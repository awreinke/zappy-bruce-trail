<gpx version="1.1" creator="Claude Bruce Trail planner" xmlns="http://www.topografix.com/GPX/1/1">
<metadata><name>Day 24 - Great Esker, Reservoir, Trafalgar, Duff Pit</name></metadata>
<wpt lat="43.679840" lon="-79.966419"><name>P Start/finish parking</name><desc>Roadside parking across from the Eighth Line Side Trail on Eighth Line</desc><sym>Parking Area</sym></wpt>
<wpt lat="43.679143" lon="-79.969333"><name>J1</name><desc>J1: Turn sharp right onto the blue-blazed Great Esker Side Trail, heading north. (the blue-blazed Great Esker Side Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.679648" lon="-79.971483"><name>J2</name><desc>J2: Turn left onto the white-blazed main Bruce Trail, heading south-west. (the white-blazed main Bruce Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.677770" lon="-79.973935"><name>J3</name><desc>J3: Continue straight onto the blue-blazed Great Esker Side Trail, heading west. (the white-blazed main Bruce Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.674093" lon="-79.976478"><name>J4</name><desc>J4: Turn right onto the blue-blazed Trafalgar Side Trail, heading west. (the blue-blazed Great Esker Side Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.671144" lon="-79.982061"><name>J5</name><desc>J5: Turn right onto the blue-blazed North Rim Side Trail, heading west. (the blue-blazed Trafalgar Side Trail goes off ahead.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.668412" lon="-79.986684"><name>J6</name><desc>J6: Turn left onto the blue-blazed Duff Pit Side Trail, heading south-east. (the blue-blazed Duff Pit Side Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.667463" lon="-79.980163"><name>J7</name><desc>J7: Turn right onto the blue-blazed Reservoir Side Trail, heading south-east. (the blue-blazed Trafalgar Side Trail goes off on your left.) This is a short excursion (about 1160 m in all): walk the whole Reservoir Side Trail, including the short loop or branch near its end (see the map), and come back to this junction.</desc><sym>Waypoint</sym></wpt>
