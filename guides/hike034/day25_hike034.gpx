<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="Claude Bruce Trail planner" xmlns="http://www.topografix.com/GPX/1/1">
<metadata><name>Day 25 - Snows Creek, Reservoir, North Rim, Maureen Smith</name></metadata>
<wpt lat="43.687353" lon="-79.990897"><name>P Start/finish parking</name><desc>Scotsdale Farm: Enter from Trafalgar Rd, 1.7 km northwest of Highway 7. Free</desc><sym>Parking Area</sym></wpt>
<wpt lat="43.692270" lon="-79.983390"><name>P2 alternative parking</name><desc>In the laneway off the west side of Eighth Line where the Bennett Heritage Trail crosses. Free. Joins the route near km 0.9 (120 m walk).</desc><sym>Parking Area</sym></wpt>
<wpt lat="43.679840" lon="-79.966420"><name>P3 alternative parking</name><desc>Roadside parking across from the Eighth Line Side Trail on Eighth Line. Free. Joins the route near km 3.3 (1080 m walk).</desc><sym>Parking Area</sym></wpt>
<wpt lat="43.686280" lon="-79.975580"><name>P4 alternative parking</name><desc>Roadside parking on the eastern shoulder of Eighth Line at the southernmost intersection with…. Free. Joins the route near km 3.3 (1340 m walk).</desc><sym>Parking Area</sym></wpt>
<wpt lat="43.666160" lon="-79.995900"><name>P5 alternative parking</name><desc>Sixth Line parking (north), new July 2026 for the Silver Creek trail changes (BTC notice…. Fee unclear. Joins the route near km 9.1 (990 m walk).</desc><sym>Parking Area</sym></wpt>
<wpt lat="43.691636" lon="-79.983985"><name>J1</name><desc>J1: Turn right onto the blue-blazed Maureen Smith Side Trail, heading south-east. (the blue-blazed Bennett Heritage Trail goes off ahead.) There is trailhead parking here (In the laneway off the west side of Eighth Line where the Bennett Heritage Trail crosses).</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.687791" lon="-79.981866"><name>J2</name><desc>J2: Junction. Turn left to stay on the Maureen Smith Side Trail, heading south-east. (the blue-blazed Snows Creek Side Trail goes off ahead.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.677770" lon="-79.973935"><name>J3</name><desc>J3: Turn right onto the blue-blazed Silver Creek Side Trail, heading west. (the blue-blazed Maureen Smith Side Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.674093" lon="-79.976478"><name>J4</name><desc>J4: Turn right onto the white-blazed main Bruce Trail, heading west. (the white-blazed main Bruce Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.671144" lon="-79.982061"><name>J5</name><desc>J5: Turn right onto the blue-blazed North Rim Side Trail, heading west. (the white-blazed main Bruce Trail goes off ahead.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.668412" lon="-79.986684"><name>J6</name><desc>J6: Turn left onto the white-blazed main Bruce Trail, heading south-east. (the blue-blazed Snows Creek Side Trail goes off on your right; the white-blazed main Bruce Trail goes off ahead.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.667463" lon="-79.980163"><name>J7</name><desc>J7: Turn right onto the blue-blazed Reservoir Side Trail, heading south-east. (the white-blazed main Bruce Trail goes off on your left.) This is a short excursion (about 1160 m in all): walk the whole Reservoir Side Trail, including the short loop or branch near its end (see the map), and come back to this junction.</desc><sym>Waypoint</sym></wpt>
<wpt lat="43.680256" lon="-79.990120"><name>J8</name><desc>J8: Continue straight onto the blue-blazed Bennett Heritage Trail, heading north-west. (the blue-blazed Snows Creek Side Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<trk><name>Day 25 - Snows Creek, Reservoir, North Rim, Maureen Smith (11.3 km)</name><trkseg>
