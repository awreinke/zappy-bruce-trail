<gpx version="1.1" creator="Claude Bruce Trail planner" xmlns="http://www.topografix.com/GPX/1/1">
<metadata><name>Day 41 - Oliver Creek, Moss Haven, Enchanted Forest, 2nd Line ECL</name></metadata>
<wpt lat="44.145874" lon="-80.101399"><name>P Start/finish parking</name><desc>Roadside parallel parking on west side of 2nd Line E. Free</desc><sym>Parking Area</sym></wpt>
<wpt lat="44.148250" lon="-80.118530"><name>P2 alternative parking</name><desc>Bruce Trail parking on the 1st Line E (emergency #716599). Free. Joins the route near km 1.5 (800 m walk).</desc><sym>Parking Area</sym></wpt>
<wpt lat="44.146877" lon="-80.101220"><name>J1</name><desc>J1: Turn left onto the blue-blazed Oliver Creek Side Trail, heading north. (the blue-blazed Oliver Creek Side Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.150080" lon="-80.102196"><name>J2</name><desc>J2: Turn left onto the white-blazed main Bruce Trail, heading west. (the white-blazed main Bruce Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.150038" lon="-80.105986"><name>J3</name><desc>J3: Continue straight onto the blue-blazed Moss Haven Side Trail, heading south-west. (the white-blazed main Bruce Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.149841" lon="-80.110741"><name>J4</name><desc>J4: Turn sharp right onto the white-blazed main Bruce Trail, heading east. (the white-blazed main Bruce Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.150935" lon="-80.108973"><name>J5</name><desc>J5: Turn right onto the blue-blazed Enchanted Forest Side Trail, heading north-east. (the white-blazed main Bruce Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.151519" lon="-80.107702"><name>J6</name><desc>J6: Turn right onto the white-blazed main Bruce Trail, heading south-east. (the white-blazed main Bruce Trail goes off behind you.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.147513" lon="-80.095183"><name>J7</name><desc>J7: Turnaround point. The side trail meets the white-blazed main Bruce Trail here. Turn around and retrace your steps.</desc><sym>Waypoint</sym></wpt>
