<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="Claude Bruce Trail planner" xmlns="http://www.topografix.com/GPX/1/1">
<metadata><name>Day 43 - Nottawasaga Bluffs Lookout, Keyhole</name></metadata>
<wpt lat="44.342784" lon="-80.210628"><name>P Start/finish parking</name><desc>Accessible only from Con 10 South, this small parking area off 15/16 Sideroad is provided…. Paid: $15 + HST per vehicle (day)</desc><sym>Parking Area</sym></wpt>
<wpt lat="44.337877" lon="-80.208320"><name>J1</name><desc>J1: Junction. Turn right to stay on the main Bruce Trail, heading west. (the blue-blazed Betty Carter Side Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.335704" lon="-80.210343"><name>J2</name><desc>J2: Junction. Continue straight to stay on the main Bruce Trail, heading south. (the blue-blazed Keyhole Side Trail goes off on your right.) Then, turn right onto the blue-blazed Nottawasaga Bluffs Lookout Side Trail, heading south-west. (the white-blazed main Bruce Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.335234" lon="-80.212721"><name>J3</name><desc>J3: Junction. Turn left to stay on the Nottawasaga Bluffs Lookout Side Trail, heading south. (the blue-blazed Keyhole Side Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.333128" lon="-80.212774"><name>J4</name><desc>J4: Turnaround point. The side trail meets the white-blazed main Bruce Trail here. Turn around and retrace your steps.</desc><sym>Waypoint</sym></wpt>
