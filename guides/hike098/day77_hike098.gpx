<metadata><name>Day 77 - Inland, Donna Baker, McKay's Harbour, Geodetic</name></metadata>
<wpt lat="44.990102" lon="-81.242282"><name>P Start/finish parking</name><desc>McCurdy Drive Municipal Parking Lot (off of Moore St.): Online booking is required -…</desc><sym>Parking Area</sym></wpt>
<wpt lat="44.987503" lon="-81.239102"><name>J1</name><desc>J1: Junction. Continue straight to stay on the main Bruce Trail, heading east. (the blue-blazed Warder Side Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.989703" lon="-81.233136"><name>J2</name><desc>J2: Junction. Continue straight to stay on the main Bruce Trail, heading east. (the blue-blazed Ilse Hanel Side Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.998229" lon="-81.228007"><name>J3</name><desc>J3: Junction. Continue straight to stay on the main Bruce Trail, heading north. (the blue-blazed Giant's Cauldron Side Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="45.000351" lon="-81.229424"><name>J4</name><desc>J4: Junction. Continue straight to stay on the main Bruce Trail, heading north. (the blue-blazed Lion's Head Pothole Side Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="45.004668" lon="-81.226941"><name>J5</name><desc>J5: Turn sharp right onto the blue-blazed Inland Side Trail, heading south. (the white-blazed main Bruce Trail goes off ahead.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="45.001352" lon="-81.219645"><name>J6</name><desc>J6: Turn left onto the blue-blazed Donna Baker Side Trail, heading north. (the blue-blazed Inland Side Trail goes off ahead.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="45.004519" lon="-81.215622"><name>J7</name><desc>J7: Turn left onto the white-blazed main Bruce Trail, heading east. (the white-blazed main Bruce Trail goes off ahead.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="45.004693" lon="-81.213948"><name>J8</name><desc>J8: Turn right onto the blue-blazed McKay's Harbour Side Trail, heading south-east. (the white-blazed main Bruce Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="45.004264" lon="-81.212259"><name>J9</name><desc>J9: End of the McKay's Harbour Side Trail. Turn around and retrace your steps.</desc><sym>Waypoint</sym></wpt>
<wpt lat="45.001108" lon="-81.215318"><name>J10</name><desc>J10: Turn right onto the blue-blazed Geodetic Side Trail, heading south. (the blue-blazed Inland Side Trail goes off ahead.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="45.000253" lon="-81.215327"><name>J11</name><desc>J11: End of the Geodetic Side Trail. Turn around and retrace your steps.</desc><sym>Waypoint</sym></wpt>
