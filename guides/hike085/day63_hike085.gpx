<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="Claude Bruce Trail planner" xmlns="http://www.topografix.com/GPX/1/1">
<metadata><name>Day 63 - Coles, Mystery Cabin, Don Richards, Kemble Wetland, Cedar Point, MapleCross Ridge, Birch Camp</name></metadata>
<wpt lat="44.733240" lon="-80.958269"><name>P Start/finish parking</name><desc>Roadside parking on the shoulder of Cole's Side Rd, just as it turns into a logging road. Free</desc><sym>Parking Area</sym></wpt>
<wpt lat="44.735607" lon="-80.963916"><name>J1</name><desc>J1: Turn right onto the blue-blazed Mystery Cabin Side Trail, heading north. (the blue-blazed Don Richards Side Trail goes off ahead.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.742159" lon="-80.958695"><name>J2</name><desc>J2: Continue straight onto the blue-blazed Coles Side Trail, heading north-west. (the white-blazed main Bruce Trail goes off on your left; the white-blazed main Bruce Trail goes off on your right.) The next 1.0 km follows an unopened road allowance (rough track, no traffic).</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.751215" lon="-80.959321"><name>J3</name><desc>J3: Turn right onto the blue-blazed MapleCross Ridge Side Trail, heading east. (the blue-blazed Coles Side Trail goes off ahead.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.751421" lon="-80.954292"><name>J4</name><desc>J4: Turnaround point. The side trail meets the white-blazed main Bruce Trail here. Turn around and retrace your steps.</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.760623" lon="-80.959630"><name>J5</name><desc>J5: Turnaround point. Turn around and retrace your steps.</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.736166" lon="-80.965773"><name>J6</name><desc>J6: Turn left onto the blue-blazed Kemble Wetland Side Trail, heading south-west. (the blue-blazed Don Richards Side Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.734322" lon="-80.973212"><name>J7</name><desc>J7: Turn right onto the white-blazed main Bruce Trail, heading north. (the white-blazed main Bruce Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.740209" lon="-80.969471"><name>J8</name><desc>J8: Turn left onto the blue-blazed Cedar Point Side Trail, heading west. (the white-blazed main Bruce Trail goes off on your right.) This is a short excursion (about 850 m in all): walk the whole Cedar Point Side Trail, including the short loop or branch near its end (see the map), and come back to this junction.</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.740244" lon="-80.967614"><name>J9</name><desc>J9: Turn left onto the blue-blazed Birch Camp Side Trail, heading north. (the white-blazed main Bruce Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.740937" lon="-80.967589"><name>J10</name><desc>J10: End of the Birch Camp Side Trail. Turn around and retrace your steps.</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.736949" lon="-80.966378"><name>J11</name><desc>J11: Turn right onto the blue-blazed Don Richards Side Trail, heading south-east. (the white-blazed main Bruce Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<trk><name>Day 63 - Coles, Mystery Cabin, Don Richards, Kemble Wetland, Cedar Point, MapleCross Ridge, Birch Camp (12.0 km)</name><trkseg>
