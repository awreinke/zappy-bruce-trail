<metadata><name>Day 49 - Len Gertler</name></metadata>
<wpt lat="44.504973" lon="-80.331780"><name>P Start/finish parking</name><desc>Roadside parking along the north side of Maple Lane</desc><sym>Parking Area</sym></wpt>
<wpt lat="44.503652" lon="-80.337877"><name>J1</name><desc>J1: Junction. Continue straight to stay on the main Bruce Trail, heading west. (the blue-blazed Swiss Meadows Side Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.511539" lon="-80.355352"><name>J2</name><desc>J2: Junction. Turn right to stay on the main Bruce Trail, heading north-west. (the blue-blazed Intercept Side Trail goes off ahead.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.512082" lon="-80.363863"><name>J3</name><desc>J3: Junction. Turn right to stay on the main Bruce Trail, heading west. (the blue-blazed Loree Side Trail goes off ahead.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.515427" lon="-80.364670"><name>J4</name><desc>J4: Turn left onto the blue-blazed Len Gertler Side Trail, heading west. (the white-blazed main Bruce Trail goes off ahead.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.520190" lon="-80.368028"><name>J5</name><desc>J5: Junction. Turn left to stay on the Len Gertler Side Trail, heading west. (the blue-blazed Len Gertler Connector Side Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.518309" lon="-80.376391"><name>J6</name><desc>J6: Turnaround point. Turn around and retrace your steps.</desc><sym>Waypoint</sym></wpt>
