<gpx version="1.1" creator="Claude Bruce Trail planner" xmlns="http://www.topografix.com/GPX/1/1">
<metadata><name>Day 46 - Petun, John Haigh, Black Ash Creek</name></metadata>
<wpt lat="44.449741" lon="-80.307524"><name>P Start/finish parking</name><desc>A small parking area on the east side of 2nd Line provided by the Nottawasaga Valley…. Paid: $15 + HST per vehicle (day)</desc><sym>Parking Area</sym></wpt>
<wpt lat="44.448293" lon="-80.304432"><name>J1</name><desc>J1: Turn left onto the white-blazed main Bruce Trail, heading north-east. (the white-blazed main Bruce Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.453066" lon="-80.292937"><name>J2</name><desc>J2: Continue straight onto the blue-blazed Petun Side Trail, heading east. (the white-blazed main Bruce Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.457942" lon="-80.310074"><name>J3</name><desc>J3: Junction. Turn left to stay on the Petun Side Trail, heading south. (the white-blazed main Bruce Trail goes off on your right; the white-blazed main Bruce Trail goes off ahead.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.446836" lon="-80.309011"><name>J4</name><desc>J4: Continue straight onto the blue-blazed John Haigh Side Trail, heading south. (the white-blazed main Bruce Trail goes off on your left; the white-blazed main Bruce Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.437311" lon="-80.297249"><name>J5</name><desc>J5: Turnaround point. The side trail meets the white-blazed main Bruce Trail here. Turn around and retrace your steps.</desc><sym>Waypoint</sym></wpt>
