<gpx version="1.1" creator="Claude Bruce Trail planner" xmlns="http://www.topografix.com/GPX/1/1">
<metadata><name>Day 60 (stop 1 of 2) - Ron Savage, Frank Holley, The Glen, East Linton</name></metadata>
<wpt lat="44.649257" lon="-80.964331"><name>P Start/finish parking</name><desc>Roadside parking at the base of the Escarpment on East Linton Rd, provides access to the…. Free</desc><sym>Parking Area</sym></wpt>
<wpt lat="44.642210" lon="-81.000280"><name>P2 alternative parking</name><desc>Roadside parking on County Rd 17, provides access to The Glen Side Trail. Free. Joins the route near km 3.7 (0 m walk).</desc><sym>Parking Area</sym></wpt>
<wpt lat="44.649571" lon="-80.965130"><name>J1</name><desc>J1: Turn right onto the white-blazed main Bruce Trail, heading north. (the white-blazed main Bruce Trail goes off on your left.) Then, junction. Turn right to stay on the main Bruce Trail, heading north. (the blue-blazed Frank Holley Side Trail goes off ahead.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.651212" lon="-80.973251"><name>J2</name><desc>J2: Junction. Continue straight to stay on the main Bruce Trail, heading south-west. (the blue-blazed Frank Holley Side Trail goes off on your left.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.649071" lon="-80.979267"><name>J3</name><desc>J3: Junction. Continue straight to stay on the main Bruce Trail, heading west. (the blue-blazed Ron Savage Side Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.643581" lon="-80.995448"><name>J4</name><desc>J4: Junction. Continue straight to stay on the main Bruce Trail, heading west. (the blue-blazed Ron Savage Side Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.643905" lon="-80.996444"><name>J5</name><desc>J5: Turn left onto the blue-blazed The Glen Side Trail, heading west. (the white-blazed main Bruce Trail goes off on your right.)</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.642231" lon="-81.000391"><name>J6</name><desc>J6: End of the The Glen Side Trail. There is trailhead parking here (Roadside parking on County Rd 17, provides access to The Glen Side Trail). Turn around and retrace your steps.</desc><sym>Waypoint</sym></wpt>
<wpt lat="44.652273" lon="-80.969126"><name>J7</name><desc>J7: Junction. Continue straight to stay on the Frank Holley Side Trail, heading east. (the blue-blazed Walker Homestead Side Trail goes off behind you.)</desc><sym>Waypoint</sym></wpt>
